# ---------------------------------------------------------------------------
# Public-repo hygiene (2026-09-14)
# ---------------------------------------------------------------------------

# Vendor/extracted assets: third-party copyrighted material. Kept locally for
# reference only, never committed/published.
fw_picked/

# Console/controller dumps and captures (vendor ds.json, pcaps, trace logs).
# Kept on disk only.
/work/yi-protect/

# Local-only third-party reference clones (not submodules).
repos/allwinner-isp6xx/
repos/lindenis-v833-softwinner/
repos/tinalinux-package/
# Vendored cross-toolchain (not tracked; cloned manually / by CI for builds).
repos/toolchain-sunxi-musl/
repos/lindenis-v536-prebuilt/
repos/lindenis-v833-prebuilt/
# Vendor Allwinner SDK (only used by the retired rmm_replacement prototype).
repos/lindenis-v536-softwinner/
# Research-only reference clones, no longer submodules.
repos/onvif_simple_server/
repos/unifi-guides/
repos/finch/
repos/pyunifiwire/
repos/unifi-cam-proxy/

# Local certs/keys: never publish (private keys, runtime-generated identities).
*.pem

# Secret-bearing controller dumps (must never be committed).
archive/cameras.json

# Local working docs — kept on disk, never published (README.md is tracked).
/*.md
!/README.md

# Local archive of older notes/code — kept on disk, never published.
/archive/

# Editor swap files
*.swp
*.swo
*.crt
.env

# Credentials / keys that must never be committed.
.ssh/
id_rsa*
id_ed25519*
known_hosts
*.p12
*.pfx
*.jks

# WireGuard configs.
wg*.conf
*.wg.conf

# Static HTTPS downloader build outputs (work/downloader/build.sh).
work/downloader/downloader
work/downloader/build/

# legacy unifi-named build outputs (pre-rename, ignore too)
work/goclient/unifi_avclient_*
work/goclient/unifi-avclient
work/flv_bridge/unifi_flv_bridge
work/snapshot/unifi_snapshot
