devices.md
*.bin
*.img
*.key

# Downloaded material (toolchains, caches, upstream archives, controller dumps) — never in git
file_downloads/

# Build dependencies (local: ../repos; the release CI clones into ./repos).
/repos/

# SD-card build output (assembled by build_sd.sh)
build/
sd_root/yi-protect/bin/
sd_root/yi-protect/lib/
sd_root/yi-protect/script/lower_half/
# mediad files copied in from sisters/yi-mediad/dist by build_sd.sh (generated).
sd_root/yi-protect/script/mediad.sh
sd_root/yi-protect/etc/mediad.conf
sd_root/yi-protect/etc/mediad.env
sd_root/yi-protect/etc/mediad.*.env
# License files copied into the SD image by build_sd.sh (generated).
sd_root/LICENSE
sd_root/licenses/
sd_root/NOTICE
sd_root/SOURCES.txt
yi-protect-*.tar.gz
SHA256SUMS

# Runtime per-camera identity written onto the SD card by a booted camera.
# Never tracked, never shipped (build_sd.sh refuses to package it).
sd_root/yi-protect/etc/model_suffix
sd_root/yi-protect/etc/yi_protect_client_go.device-id
sd_root/yi-protect/etc/yi_protect_client_go.adoption-uuid
sd_root/yi-protect/etc/yi_protect_client_go.adopted
sd_root/yi-protect/etc/yi_protect_client_go.device-name
sd_root/yi-protect/etc/yi_protect_client_go.inform-host*
sd_root/yi-protect/etc/configure_wifi.cfg
sd_root/yi-protect/etc/dropbear/
sd_root/yi-protect/log/
*.applied

# Compiled build artifacts
*.o
*.d
*.a
*.so
__pycache__/
goclient/yi_protect_avclient_*
flv_bridge/yi_protect_flv_bridge
snapshot/yi_protect_snapshot

# local agent settings (may contain pasted credentials)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ---------------------------------------------------------------------------
# Public-repo hygiene
# ---------------------------------------------------------------------------

# Vendor/extracted assets: third-party copyrighted material. Kept locally for
# reference only, never committed/published.
fw_picked/

# Local certs/keys: never publish (private keys, runtime-generated identities).
*.pem

# Secret-bearing controller dumps (must never be committed).
archive/cameras.json

# Local working docs — kept on disk, never published (README.md is tracked).
/*.md
!/README.md

# Local archive of older notes/code — kept on disk, never published.
/archive/

# Editor swap files
*.swp
*.swo
*.crt
.env

# Credentials / keys that must never be committed.
.ssh/
id_rsa*
id_ed25519*
known_hosts
*.p12
*.pfx
*.jks

# WireGuard configs.
wg*.conf
*.wg.conf

# Static HTTPS downloader build outputs (downloader/build.sh).
downloader/downloader
downloader/build/

# legacy unifi-named build outputs (pre-rename, ignore too)
goclient/unifi_avclient_*
goclient/unifi-avclient
flv_bridge/unifi_flv_bridge
snapshot/unifi_snapshot
