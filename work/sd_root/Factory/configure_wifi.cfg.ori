# WiFi credentials for yi-protect's first boot, applied by Factory/config.sh.
#
# Rename this file to configure_wifi.cfg (same directory) and edit the two lines
# before the first power-on. Factory/config.sh writes them into the camera's conf
# partition (mtd7), then installs unifi and reboots, so the first post-install
# boot comes up associated. To change WiFi later, use
# unifi/etc/configure_wifi.cfg instead.
#
# Rules:
#   - one value per line, KEY=value
#   - the value may be bare or wrapped in one pair of matching double or
#     single quotes; the quotes are stripped before the value is written.
#     Quotes are recommended so leading/trailing spaces and special
#     characters are unambiguous.
#   - spaces in the SSID/PSK are allowed
#   - do not use a backslash
#   - WPA2 max length is 63 characters

wifi_ssid="My Network"
wifi_psk="my-password"
