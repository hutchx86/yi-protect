# WiFi credentials for yi-protect, applied at boot by init.sh + configure-wifi.sh.
#
# To provision: rename this file to configure_wifi.cfg (same directory), edit the
# two lines below, then reboot the camera. init.sh writes them into the camera's
# conf partition (mtd7) and reboots once so the stock WiFi stack associates.
# The file is renamed to configure_wifi.cfg.applied afterwards; to re-provision,
# rename it back, edit, and reboot.
#
# Rules:
#   - one value per line, KEY=value
#   - the value may be bare or wrapped in one pair of matching double or
#     single quotes; the quotes are stripped before the value is written.
#     Quotes are recommended so leading/trailing spaces and special
#     characters are unambiguous.
#   - spaces in the SSID/PSK are allowed
#   - do not use a backslash
#   - WPA2 max length is 63 characters

wifi_ssid="My Network"
wifi_psk="my-password"
